<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <%#
      Optimized Head Section - Critical Rendering Path
      Perceptual Near-Instantaneity: Preload critical resources, minimize blocking
    %>

    <title><%= content_for(:title) || "The Final Market - Premium Online Marketplace" %></title>

    <%# Viewport and Meta Tags - Mobile-First %>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <meta name="description" content="<%= content_for(:description) || 'Discover unique products from trusted sellers worldwide. Shop with confidence on The Final Market.' %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#667eea">

    <%# Security and CSRF %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%# Icons - Preload for Performance %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preload" href="/icon.svg" as="image" type="image/svg+xml">

    <%# Preconnect for External Resources - Reduce Latency %>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">

    <%# Critical CSS - Inline for LCP Optimization %>
    <style>
      /* Critical above-the-fold styles */
      .spinner { border: 4px solid #f3f3f3; border-top: 4px solid #667eea; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; }
      @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
      .glass { backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.9); }
      .fab { transition: transform 0.2s ease-in-out; }
      .fab:hover { transform: translateY(-2px); }
    </style>

    <%# Non-Critical Stylesheets - Async Loading %>
    <%= stylesheet_link_tag "modern_design_system", "data-turbo-track": "reload", media: "print", onload: "this.media='all'" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload", media: "print", onload: "this.media='all'" %>

    <%# JavaScript - Import Map for Modern JS %>
    <%= javascript_importmap_tags %>

    <%# External Libraries - Async for Non-Blocking %>
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css"></noscript>
    <script defer src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <%# Schema.org Structured Data - SEO and Accessibility %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "The Final Market",
      "url": "<%= root_url %>",
      "description": "<%= content_for(:description) || 'Discover unique products from trusted sellers worldwide. Shop with confidence on The Final Market.' %>",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "<%= search_url %>?query={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
  </head>

  <body class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-purple-50 antialiased">
    <%# Render Atomic Header Partial %>
    <%= render 'layouts/header' %>

    <%# Render Atomic Flash Messages Partial %>
    <%= render 'layouts/flash' %>

    <%# Main Content %>
    <main id="main-content" class="min-h-screen">
      <%= yield %>
    </main>

    <%# Render Atomic Footer Partial %>
    <%= render 'layouts/footer' %>
  </body>
</html>