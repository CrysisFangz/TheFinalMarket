<%#
  Flash Messages Partial - Atomic Presentation Component
  Pure function of props: notice, alert
  Enhanced for accessibility and progressive enhancement
%>

<%#
  Flash Messages - Turbo Frame for Dynamic Updates
  WCAG AAA compliant with proper ARIA and keyboard navigation
%>
<%= turbo_frame_tag "flash", class: "fixed top-24 right-4 z-50 space-y-2" do %>
  <% if notice %>
    <div class="toast-modern toast-success show"
         data-controller="toast"
         data-toast-duration-value="5000"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">
      <div class="flex items-center gap-3">
        <svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <span class="flex-1 font-medium text-gray-800"><%= notice %></span>
        <button data-action="click->toast#close"
                class="text-gray-400 hover:text-gray-600 transition-colors"
                aria-label="Close notification">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>
  <% end %>

  <% if alert %>
    <div class="toast-modern toast-error show"
         data-controller="toast"
         data-toast-duration-value="5000"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">
      <div class="flex items-center gap-3">
        <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
        <span class="flex-1 font-medium text-gray-800"><%= alert %></span>
        <button data-action="click->toast#close"
                class="text-gray-400 hover:text-gray-600 transition-colors"
                aria-label="Close notification">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>
  <% end %>
<% end %>