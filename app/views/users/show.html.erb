<main class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-purple-50" role="main" aria-labelledby="user-profile-title">
  <!-- Skip to main content for accessibility -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-purple-600 text-white px-4 py-2 rounded-lg z-50">
    Skip to main content
  </a>

  <!-- Breadcrumb Navigation -->
  <nav class="bg-white border-b border-gray-200" aria-label="Breadcrumb navigation">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex">
          <div class="flex-shrink-0 flex items-center">
            <ol class="flex items-center space-x-2 text-sm text-gray-500">
              <li>
                <%= link_to "Home", root_path, class: "hover:text-purple-600 transition-colors duration-200" %>
              </li>
              <li class="flex items-center">
                <svg class="flex-shrink-0 h-4 w-4 mx-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-900 font-medium" aria-current="page">User Profile</span>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <header class="bg-gradient-to-r from-purple-600 via-pink-500 to-red-500 text-white" role="banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center">
        <h1 id="user-profile-title" class="text-4xl font-bold tracking-tight sm:text-5xl">
          <%= @user.name %>
        </h1>
        <p class="mt-4 text-xl text-purple-100">
          Member since <%= @user.created_at.strftime("%B %Y") %>
        </p>
        <div class="mt-6 flex justify-center space-x-4">
          <%= render 'shared/seller_badge', user: @user %>
          <%= level_badge(@user) %>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8" role="main" id="main-content">

      <!-- User Information Sidebar -->
      <aside class="lg:col-span-1" role="complementary" aria-labelledby="user-info-title">
        <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
          <div class="p-6">
            <h2 id="user-info-title" class="text-xl font-semibold text-gray-900 mb-6 flex items-center">
              <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              Account Information
            </h2>

            <!-- User Details -->
            <dl class="space-y-4">
              <div class="flex justify-between items-center py-3 border-b border-gray-100">
                <dt class="text-sm font-medium text-gray-500">Email Address</dt>
                <dd class="text-sm text-gray-900 font-mono"><%= @user.email %></dd>
              </div>
              <div class="flex justify-between items-center py-3 border-b border-gray-100">
                <dt class="text-sm font-medium text-gray-500">Member Since</dt>
                <dd class="text-sm text-gray-900">
                  <time datetime="<%= @user.created_at.iso8601 %>">
                    <%= @user.created_at.strftime("%B %d, %Y") %>
                  </time>
                </dd>
              </div>
              <div class="flex justify-between items-center py-3 border-b border-gray-100">
                <dt class="text-sm font-medium text-gray-500">Account Status</dt>
                <dd class="text-sm">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @user.active? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                    <%= @user.active? ? 'Active' : 'Inactive' %>
                  </span>
                </dd>
              </div>
              <div class="flex justify-between items-center py-3">
                <dt class="text-sm font-medium text-gray-500">User Level</dt>
                <dd class="text-sm text-gray-900">
                  <%= render_user_level_progress(@user) %>
                </dd>
              </div>
            </dl>

            <!-- Action Buttons -->
            <div class="mt-8 space-y-3">
              <%= link_to edit_user_path(@user), class: "w-full flex justify-center items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-all duration-200" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Edit Profile
              <% end %>

              <% if current_user&.admin? %>
                <%= link_to admin_user_path(@user), class: "w-full flex justify-center items-center px-4 py-2 border border-purple-300 rounded-lg shadow-sm text-sm font-medium text-purple-700 bg-purple-50 hover:bg-purple-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-all duration-200" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  Admin Panel
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Seller Application Card -->
        <% if can_apply_as_seller? %>
          <div class="mt-6 bg-gradient-to-r from-green-50 to-emerald-50 rounded-2xl p-6 border border-green-200">
            <div class="flex items-center mb-4">
              <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-lg font-medium text-green-900">Become a Seller</h3>
                <p class="text-sm text-green-700">Start selling your products on our marketplace</p>
              </div>
            </div>
            <%= link_to "Apply Now", new_seller_application_path, class: "w-full flex justify-center items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-all duration-200" %>
          </div>
        <% end %>
      </aside>

      <!-- Main Content Area -->
      <div class="lg:col-span-2 space-y-8">

        <!-- Seller Profile Section -->
        <% if @user.gem? %>
          <section class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden" role="region" aria-labelledby="seller-profile-title">
            <div class="p-6">
              <h2 id="seller-profile-title" class="text-xl font-semibold text-gray-900 mb-6 flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
                Seller Profile
              </h2>
              <%= render 'shared/seller_profile' %>
            </div>
          </section>
        <% end %>

        <!-- Products Section -->
        <% if @user.gem? && @user.active? %>
          <section class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden" role="region" aria-labelledby="user-products-title">
            <div class="p-6">
              <h2 id="user-products-title" class="text-xl font-semibold text-gray-900 mb-6 flex items-center">
                <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
                My Products
              </h2>
              <%= render_user_products_section %>
            </div>
          </section>
        <% end %>

        <!-- Recent Activity Section -->
        <section class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden" role="region" aria-labelledby="recent-activity-title">
          <div class="p-6">
            <h2 id="recent-activity-title" class="text-xl font-semibold text-gray-900 mb-6 flex items-center">
              <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Recent Activity
            </h2>
            <div class="space-y-4">
              <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-lg">
                <div class="flex-shrink-0">
                  <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900">Profile updated</p>
                  <p class="text-sm text-gray-500">
                    <time datetime="<%= @user.updated_at.iso8601 %>">
                      <%= time_ago_in_words(@user.updated_at) %> ago
                    </time>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</main>