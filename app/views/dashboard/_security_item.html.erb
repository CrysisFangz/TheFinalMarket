<%#
  Security Item Partial
  Displays security status with interactive features
  Modern React implementation with TypeScript
%>
<div data-controller="security-item"
     data-type="<%= type %>"
     data-user="<%= current_user.to_json %>"
     data-icon="<%= icon %>"
     data-text="<%= text %>"
     data-context="<%= context.to_json %>"
     data-show-tooltip="<%= show_tooltip %>"
     data-interactive="<%= interactive %>">
</div>