<%#
  Recent Orders Widget Partial
  Displays user's recent orders with optimized queries
  Includes empty state handling and proper error boundaries
%>
<div data-controller="recent-orders-widget"
     data-orders="<%= stats.recent_orders.to_json %>"
     data-empty-message="<%= t('dashboard.no_orders', default: 'No orders yet') %>"
     data-empty-icon="<%= empty_orders_icon %>"
     data-action-link="<%= root_path %>"
     data-action-text="<%= t('dashboard.start_shopping', default: 'Start Shopping') %>">
</div>