<%#
  Statistics Card Partial
  Displays statistical data with trend analysis
  Modern React implementation with TypeScript
%>
<div data-controller="stat-card"
     data-stat-type="<%= stat_type %>"
     data-icon-svg="<%= icon_svg %>"
     data-value="<%= value %>"
     data-label="<%= label %>"
     data-change="<%= change %>"
     data-link="<%= link %>"
     data-link-text="<%= link_text %>"
     data-context="<%= context.to_json %>"
     data-interactive="<%= interactive %>">
</div>