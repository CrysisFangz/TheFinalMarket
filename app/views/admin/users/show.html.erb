<main class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-blue-50" role="main" aria-labelledby="user-details-title">
  <!-- Skip to main content for accessibility -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-600 text-white px-4 py-2 rounded-lg z-50">
    Skip to main content
  </a>

  <!-- Breadcrumb Navigation -->
  <nav class="bg-white border-b border-gray-200" aria-label="Breadcrumb navigation">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex">
          <div class="flex-shrink-0 flex items-center">
            <ol class="flex items-center space-x-2 text-sm text-gray-500">
              <li>
                <%= link_to "Admin Dashboard", admin_dashboard_path, class: "hover:text-blue-600 transition-colors duration-200" %>
              </li>
              <li class="flex items-center">
                <svg class="flex-shrink-0 h-4 w-4 mx-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
                <%= link_to "Users Management", admin_users_path, class: "hover:text-blue-600 transition-colors duration-200" %>
              </li>
              <li class="flex items-center">
                <svg class="flex-shrink-0 h-4 w-4 mx-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-900 font-medium" aria-current="page">User Details</span>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <header class="bg-gradient-to-r from-blue-600 via-purple-500 to-indigo-500 text-white" role="banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
        <div class="flex-1">
          <div class="flex items-center space-x-6">
            <!-- User Avatar -->
            <div class="flex-shrink-0">
              <% if @user.avatar&.attached? %>
                <%= image_tag @user.avatar.variant(resize_to_limit: [80, 80]),
                    class: "h-20 w-20 rounded-full object-cover ring-4 ring-white/20",
                    alt: "Avatar for #{@user.name}" %>
              <% else %>
                <div class="h-20 w-20 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center ring-4 ring-white/20">
                  <span class="text-2xl font-bold text-white"><%= @user.name.first.upcase %></span>
                </div>
              <% end %>
            </div>

            <!-- User Info -->
            <div>
              <h1 id="user-details-title" class="text-4xl font-bold tracking-tight sm:text-5xl">
                <%= @user.name %>
              </h1>
              <p class="mt-2 text-xl text-blue-100">
                @<%= @user.username %>
              </p>
              <div class="mt-4 flex flex-wrap gap-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @user.role == 'admin' ? 'bg-purple-100 text-purple-800' : (@user.role == 'moderator' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800') %>">
                  <%= @user.role.humanize %>
                </span>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @user.seller? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= @user.seller? ? "Seller" : "Buyer" %>
                </span>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @user.suspended? ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
                  <%= @user.suspended? ? "Suspended" : "Active" %>
                </span>
                <% if @user.seller_verified? %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                    <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    Verified Seller
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="mt-8 lg:mt-0 lg:ml-8">
          <div class="flex flex-col sm:flex-row gap-3">
            <%= link_to "Edit User",
                edit_admin_user_path(@user),
                class: "inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-lg text-sm font-medium text-blue-700 bg-white hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 transform hover:-translate-y-0.5 hover:shadow-lg" %>

            <%= link_to "View Profile",
                user_path(@user),
                class: "inline-flex items-center justify-center px-6 py-3 border border-white/20 rounded-lg text-sm font-medium text-white bg-white/10 backdrop-blur-sm hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white focus:border-white transition-all duration-200",
                target: "_blank" %>

            <% if @user.suspended? %>
              <%= link_to "Activate Account",
                  activate_admin_user_path(@user),
                  method: :patch,
                  class: "inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-lg text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all duration-200 transform hover:-translate-y-0.5 hover:shadow-lg",
                  data: { confirm: "Are you sure you want to activate this user account?" } %>
            <% else %>
              <%= link_to "Suspend Account",
                  suspend_admin_user_path(@user),
                  method: :patch,
                  class: "inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 transform hover:-translate-y-0.5 hover:shadow-lg",
                  data: { confirm: "Are you sure you want to suspend this user account?" } %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12" role="main" id="main-content">

    <!-- User Information Section -->
    <section class="mb-8" role="region" aria-labelledby="user-info-title">
      <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
        <header class="px-6 py-4 bg-gradient-to-r from-gray-50 to-blue-50 border-b border-gray-200">
          <h2 id="user-info-title" class="text-xl font-semibold text-gray-900 flex items-center">
            <svg class="w-6 h-6 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Account Information
          </h2>
        </header>
        <div class="px-6 py-6">
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Email</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @user.email %></dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m0 0a2 2 0 012 2m-2-2a2 2 0 00-2-2m2 2a2 2 0 012 2m0 0a2 2 0 012 2m-2-2a2 2 0 00-2-2M9 5a2 2 0 012 2v6a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Role</dt>
                <dd class="mt-1">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @user.role == 'admin' ? 'bg-purple-100 text-purple-800' : (@user.role == 'moderator' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800') %>">
                    <%= @user.role.humanize %>
                  </span>
                </dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Seller</dt>
                <dd class="mt-1">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @user.seller? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                    <%= @user.seller? ? "Yes" : "No" %>
                  </span>
                </dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Seller Verified</dt>
                <dd class="mt-1">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @user.seller_verified? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                    <%= @user.seller_verified? ? "Yes" : "No" %>
                  </span>
                </dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Status</dt>
                <dd class="mt-1">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @user.suspended? ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
                    <%= @user.suspended? ? "Suspended" : "Active" %>
                  </span>
                </dd>
              </div>
            </div>
            <% if @user.suspended? %>
              <div class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                </svg>
                <div>
                  <dt class="text-sm font-medium text-gray-500">Suspension Reason</dt>
                  <dd class="mt-1 text-sm text-gray-900"><%= @user.suspension_reason %></dd>
                </div>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    </section>

    <aside class="lg:col-span-1">
      <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <header class="px-6 py-4 bg-gray-50 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900 flex items-center">
            <svg class="w-5 h-5 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Actions
          </h2>
        </header>
        <div class="px-6 py-6 space-y-6">
          <% unless @user.suspended? %>
            <div>
              <%= form_with(url: suspend_admin_user_path(@user), method: :patch) do |form| %>
                <%= form.label :reason, "Suspension Reason", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.text_area :reason, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500" %>
                <%= form.submit "Suspend User", class: "mt-3 w-full inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors duration-200", data: { confirm: "Are you sure you want to suspend this user?" } %>
              <% end %>
            </div>
          <% end %>

          <hr class="border-gray-200">

          <div>
            <%= form_with(url: warn_admin_user_path(@user), method: :post) do |form| %>
              <%= form.label :reason, "Warning Reason", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.text_area :reason, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-yellow-500 focus:ring-yellow-500" %>
              <%= form.submit "Issue Warning", class: "mt-3 w-full inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-yellow-600 hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 transition-colors duration-200" %>
            <% end %>
          </div>

          <% if @user.seller? && !@user.seller_verified? %>
            <hr class="border-gray-200">
            <div>
              <%= button_to "Verify Seller", verify_seller_admin_user_path(@user), method: :patch, class: "w-full inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors duration-200" %>
            </div>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
</main>
