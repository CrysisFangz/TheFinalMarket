<div class="container mt-4" role="region" aria-label="Flash messages">
  <% flash.each do |name, msg| %>
    <div class="alert alert-<%= name == 'notice' ? 'success' : name %> alert-dismissible fade show" role="alert" aria-live="polite">
      <%= msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close alert"></button>
    </div>
  <% end %>
</div>