<main class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-purple-50" role="main" aria-labelledby="seller-applications-title">
  <!-- Skip to main content for accessibility -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-purple-600 text-white px-4 py-2 rounded-lg z-50">
    Skip to main content
  </a>

  <!-- Breadcrumb Navigation -->
  <nav class="bg-white border-b border-gray-200" aria-label="Breadcrumb navigation">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex">
          <div class="flex-shrink-0 flex items-center">
            <ol class="flex items-center space-x-2 text-sm text-gray-500">
              <li>
                <%= link_to "Admin Dashboard", admin_dashboard_path, class: "hover:text-purple-600 transition-colors duration-200" %>
              </li>
              <li class="flex items-center">
                <svg class="flex-shrink-0 h-4 w-4 mx-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-900 font-medium" aria-current="page">Seller Applications</span>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <header class="bg-gradient-to-r from-purple-600 via-pink-500 to-red-500 text-white" role="banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
        <div class="flex-1">
          <h1 id="seller-applications-title" class="text-4xl font-bold tracking-tight sm:text-5xl flex items-center">
            <svg class="w-10 h-10 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            Seller Applications
          </h1>
          <p class="mt-4 text-xl text-purple-100">
            Review and manage seller applications from users who want to sell on the platform
          </p>
        </div>

        <!-- Quick Stats -->
        <div class="mt-8 lg:mt-0 lg:ml-8">
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 text-center">
              <div class="text-2xl font-bold"><%= @seller_applications.count %></div>
              <div class="text-sm text-purple-100">Pending</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 text-center">
              <div class="text-2xl font-bold"><%= @seller_applications.approved.count %></div>
              <div class="text-sm text-purple-100">Approved</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

    <!-- Main Content Area -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12" role="main" id="main-content">

    <!-- Search and Filter Controls -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden mb-8">
      <div class="p-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">

          <!-- Search Bar -->
          <div class="flex-1 max-w-lg">
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              <input type="text"
                     class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 sm:text-sm"
                     placeholder="Search applications by business name, user, or email..."
                     data-action="input->admin-applications#search"
                     data-admin-applications-target="searchInput">
            </div>
          </div>

          <!-- Filter Controls -->
          <div class="flex flex-col sm:flex-row gap-3">
            <!-- Status Filter -->
            <select class="block px-3 py-2 border border-gray-300 rounded-lg bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 sm:text-sm"
                    data-action="change->admin-applications#filter"
                    data-admin-applications-target="statusFilter">
              <option value="">All Statuses</option>
              <option value="pending">Pending</option>
              <option value="approved">Approved</option>
              <option value="rejected">Rejected</option>
            </select>

            <!-- Sort Options -->
            <select class="block px-3 py-2 border border-gray-300 rounded-lg bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 sm:text-sm"
                    data-action="change->admin-applications#sort"
                    data-admin-applications-target="sortSelect">
              <option value="created_at_desc">Newest First</option>
              <option value="created_at_asc">Oldest First</option>
              <option value="business_name_asc">Business Name A-Z</option>
              <option value="business_name_desc">Business Name Z-A</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <% if @seller_applications.any? %>
      <!-- Applications Table -->
      <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200" role="table" aria-label="Seller Applications List" data-admin-applications-target="table">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">
                  <div class="flex items-center space-x-1">
                    <span>Applicant</span>
                    <button class="text-gray-400 hover:text-gray-600" data-action="click->admin-applications#sortBy" data-column="user">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
                      </svg>
                    </button>
                  </div>
                </th>
                <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Business Details</th>
                <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Contact Information</th>
                <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">
                  <div class="flex items-center space-x-1">
                    <span>Submitted</span>
                    <button class="text-gray-400 hover:text-gray-600" data-action="click->admin-applications#sortBy" data-column="created_at">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
                      </svg>
                    </button>
                  </div>
                </th>
                <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-900 uppercase tracking-wider">Status</th>
                <th scope="col" class="px-6 py-4 text-right text-xs font-semibold text-gray-900 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200" data-admin-applications-target="tableBody">
              <% @seller_applications.each do |application| %>
                <tr class="hover:bg-gray-50 transition-colors duration-200" data-application-id="<%= application.id %>">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                      <div class="flex-shrink-0 h-12 w-12">
                        <% if application.user.avatar&.attached? %>
                          <%= image_tag application.user.avatar.variant(resize_to_limit: [48, 48]),
                              class: "h-12 w-12 rounded-full object-cover ring-2 ring-gray-100",
                              alt: "Avatar for #{application.user.name}" %>
                        <% else %>
                          <div class="h-12 w-12 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center ring-2 ring-gray-100">
                            <span class="text-sm font-semibold text-white"><%= application.user.name.first.upcase %></span>
                          </div>
                        <% end %>
                      </div>
                      <div class="ml-4">
                        <div class="text-sm font-semibold text-gray-900"><%= application.user.name %></div>
                        <div class="text-sm text-gray-500">@<%= application.user.username %></div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm font-medium text-gray-900"><%= application.business_name %></div>
                    <div class="text-sm text-gray-500"><%= application.business_type %></div>
                    <div class="text-xs text-gray-400 mt-1"><%= application.business_description&.truncate(100) %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 font-mono"><%= application.user.email %></div>
                    <div class="text-sm text-gray-500"><%= application.phone_number %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <time datetime="<%= application.created_at.iso8601 %>" title="<%= application.created_at.strftime("%B %d, %Y at %I:%M %p") %>">
                      <%= time_ago_in_words(application.created_at) %> ago
                    </time>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%=
                      case application.status
                      when 'pending'
                        'bg-yellow-100 text-yellow-800'
                      when 'approved'
                        'bg-green-100 text-green-800'
                      when 'rejected'
                        'bg-red-100 text-red-800'
                      else
                        'bg-gray-100 text-gray-800'
                      end
                    %>">
                      <%= application.status.humanize %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <div class="flex items-center justify-end space-x-2">
                      <%= link_to "View Details",
                          admin_seller_application_path(application),
                          class: "inline-flex items-center px-3 py-1 border border-purple-300 rounded-lg text-sm font-medium text-purple-700 bg-white hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-colors duration-200",
                          "aria-label": "View details for #{application.business_name}" %>

                      <% if application.pending? %>
                        <%= link_to "Approve",
                            approve_admin_seller_application_path(application),
                            method: :patch,
                            class: "inline-flex items-center px-3 py-1 border border-transparent rounded-lg text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors duration-200",
                            data: { confirm: "Are you sure you want to approve this seller application?" },
                            "aria-label": "Approve application for #{application.business_name}" %>

                        <%= link_to "Reject",
                            reject_admin_seller_application_path(application),
                            method: :patch,
                            class: "inline-flex items-center px-3 py-1 border border-transparent rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors duration-200",
                            data: { confirm: "Are you sure you want to reject this seller application?" },
                            "aria-label": "Reject application for #{application.business_name}" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Loading State -->
        <div class="hidden text-center py-12" data-admin-applications-target="loadingState">
          <div class="inline-flex items-center px-4 py-2 font-semibold leading-6 text-sm shadow rounded-md text-gray-500 bg-white">
            <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Loading applications...
          </div>
        </div>
      </div>

      <!-- Pagination -->
      <% if @seller_applications.respond_to?(:total_pages) && @seller_applications.total_pages > 1 %>
        <div class="mt-8 flex justify-center">
          <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
            <%= will_paginate @seller_applications, class: "pagination" %>
          </nav>
        </div>
      <% end %>
    <% else %></search>
</search_and_replace>
    <div class="bg-white shadow-lg rounded-lg overflow-hidden">
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No Pending Applications</h3>
        <p class="mt-1 text-sm text-gray-500">All seller applications have been reviewed.</p>
      </div>
    </div>
  <% end %>
</main>
