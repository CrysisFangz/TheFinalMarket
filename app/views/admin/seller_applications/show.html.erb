<main class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-purple-50" role="main" aria-labelledby="application-details-title">
  <!-- Skip to main content for accessibility -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-purple-600 text-white px-4 py-2 rounded-lg z-50">
    Skip to main content
  </a>

  <!-- Breadcrumb Navigation -->
  <nav class="bg-white border-b border-gray-200" aria-label="Breadcrumb navigation">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex">
          <div class="flex-shrink-0 flex items-center">
            <ol class="flex items-center space-x-2 text-sm text-gray-500">
              <li>
                <%= link_to "Admin Dashboard", admin_dashboard_path, class: "hover:text-purple-600 transition-colors duration-200" %>
              </li>
              <li class="flex items-center">
                <svg class="flex-shrink-0 h-4 w-4 mx-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
                <%= link_to "Seller Applications", admin_seller_applications_path, class: "hover:text-purple-600 transition-colors duration-200" %>
              </li>
              <li class="flex items-center">
                <svg class="flex-shrink-0 h-4 w-4 mx-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-900 font-medium" aria-current="page">Application Details</span>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <header class="bg-gradient-to-r from-purple-600 via-pink-500 to-red-500 text-white" role="banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
        <div class="flex-1">
          <div class="flex items-center space-x-6">
            <!-- Business Avatar -->
            <div class="flex-shrink-0">
              <div class="h-20 w-20 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center ring-4 ring-white/20">
                <span class="text-2xl font-bold text-white"><%= @seller_application.business_name.first.upcase %></span>
              </div>
            </div>

            <!-- Application Info -->
            <div>
              <h1 id="application-details-title" class="text-4xl font-bold tracking-tight sm:text-5xl">
                <%= @seller_application.business_name %>
              </h1>
              <p class="mt-2 text-xl text-purple-100">
                Application by <%= @seller_application.user.name %>
              </p>
              <div class="mt-4 flex flex-wrap gap-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%=
                  case @seller_application.status
                  when 'pending'
                    'bg-yellow-100 text-yellow-800'
                  when 'approved'
                    'bg-green-100 text-green-800'
                  when 'rejected'
                    'bg-red-100 text-red-800'
                  else
                    'bg-gray-100 text-gray-800'
                  end
                %>">
                  <%= @seller_application.status.humanize %>
                </span>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                  <%= @seller_application.business_type %>
                </span>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                  <time datetime="<%= @seller_application.created_at.iso8601 %>">
                    <%= time_ago_in_words(@seller_application.created_at) %> ago
                  </time>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="mt-8 lg:mt-0 lg:ml-8">
          <div class="flex flex-col sm:flex-row gap-3">
            <% if @seller_application.pending? %>
              <%= link_to "Approve Application",
                  approve_admin_seller_application_path(@seller_application),
                  method: :patch,
                  class: "inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-lg text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all duration-200 transform hover:-translate-y-0.5 hover:shadow-lg",
                  data: { confirm: "Are you sure you want to approve this seller application?" } %>

              <%= link_to "Reject Application",
                  reject_admin_seller_application_path(@seller_application),
                  method: :patch,
                  class: "inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 transform hover:-translate-y-0.5 hover:shadow-lg",
                  data: { confirm: "Are you sure you want to reject this seller application?" } %>
            <% elsif @seller_application.approved? %>
              <%= link_to "Revoke Approval",
                  reject_admin_seller_application_path(@seller_application),
                  method: :patch,
                  class: "inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 transform hover:-translate-y-0.5 hover:shadow-lg",
                  data: { confirm: "Are you sure you want to revoke approval for this seller application?" } %>
            <% end %>

            <%= link_to "View User Profile",
                admin_user_path(@seller_application.user),
                class: "inline-flex items-center justify-center px-6 py-3 border border-white/20 rounded-lg text-sm font-medium text-white bg-white/10 backdrop-blur-sm hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white focus:border-white transition-all duration-200",
                target: "_blank" %>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12" role="main" id="main-content">

    <!-- Application Details Section -->
    <section class="mb-8" role="region" aria-labelledby="application-info-title">
      <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
        <header class="px-6 py-4 bg-gradient-to-r from-gray-50 to-purple-50 border-b border-gray-200">
          <h2 id="application-info-title" class="text-xl font-semibold text-gray-900 flex items-center">
            <svg class="w-6 h-6 text-purple-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Application Information
          </h2>
        </header>
        <div class="px-6 py-6">
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">User</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @seller_application.user.username %></dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Business Name</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @seller_application.business_name %></dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Reason for Selling</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @seller_application.reason_for_selling %></dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Website or Social Media</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @seller_application.website_or_social_media %></dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Status</dt>
                <dd class="mt-1">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @seller_application.status == 'approved' ? 'bg-green-100 text-green-800' : (@seller_application.status == 'rejected' ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800') %>">
                    <%= @seller_application.status.humanize %>
                  </span>
                </dd>
              </div>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <aside>
      <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <header class="px-6 py-4 bg-gray-50 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900 flex items-center">
            <svg class="w-5 h-5 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Update Application
          </h2>
        </header>
        <div class="px-6 py-6">
          <%= form_with(model: [:admin, @seller_application], class: "space-y-6") do |form| %>
            <div>
              <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700" %>
              <%= form.select :status, SellerApplication.statuses.keys.map { |status| [status.humanize, status] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>

            <div>
              <%= form.label :feedback, "Feedback", class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_area :feedback, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>

            <%= form.submit "Update Application", class: "w-full inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
</main>
