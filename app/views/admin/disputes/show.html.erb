<main class="container mx-auto px-4 py-8">
  <nav aria-label="Breadcrumb navigation" class="mb-6">
    <ol class="flex flex-wrap items-center space-x-2 text-sm text-gray-500">
      <li>
        <%= link_to "Admin", admin_root_path, class: "text-blue-600 hover:text-blue-800 transition-colors duration-200" %>
      </li>
      <li class="flex items-center">
        <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
        </svg>
        <%= link_to "Disputes", admin_disputes_path, class: "text-blue-600 hover:text-blue-800 transition-colors duration-200" %>
      </li>
      <li class="flex items-center">
        <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
        </svg>
        <span class="text-gray-900 font-medium" aria-current="page">Order #<%= @dispute.order_id %></span>
      </li>
    </ol>
  </nav>

  <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-4 sm:mb-0 flex items-center">
      <svg class="w-8 h-8 text-yellow-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
      </svg>
      Dispute for Order #<%= @dispute.order_id %>
    </h1>
    <div class="flex flex-col sm:flex-row gap-3">
      <%= link_to admin_disputes_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Disputes
      <% end %>
      <%= link_to "Edit Dispute", edit_admin_dispute_path(@dispute), class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <section class="lg:col-span-2">
      <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
        <header class="px-6 py-4 bg-gray-50 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900 flex items-center">
            <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Dispute Details
          </h2>
        </header>
        <div class="px-6 py-6">
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Status</dt>
                <dd class="mt-1">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @dispute.status == 'resolved' ? 'bg-green-100 text-green-800' : (@dispute.status == 'pending' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800') %>">
                    <%= @dispute.status.humanize %>
                  </span>
                </dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Moderator</dt>
                <dd class="mt-1">
                  <%= @dispute.moderator&.username || '<span class="text-gray-400">Unassigned</span>'.html_safe %>
                </dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Buyer</dt>
                <dd class="mt-1">
                  <%= link_to @dispute.buyer.username, admin_user_path(@dispute.buyer), class: "text-blue-600 hover:text-blue-800 transition-colors duration-200" %>
                </dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Seller</dt>
                <dd class="mt-1">
                  <%= link_to @dispute.seller.username, admin_user_path(@dispute.seller), class: "text-blue-600 hover:text-blue-800 transition-colors duration-200" %>
                </dd>
              </div>
            </div>
          </dl>
        </div>
      </div>

      <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
        <header class="px-6 py-4 bg-gray-50 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900 flex items-center">
            <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            Comments
          </h2>
        </header>
        <div class="px-6 py-6">
          <% if @dispute_comments.any? %>
            <% @dispute_comments.each do |comment| %>
              <div class="mb-4 p-4 border border-gray-200 rounded-lg">
                <div class="flex justify-between items-center mb-2">
                  <strong class="text-gray-900"><%= comment.user.username %></strong>
                  <small class="text-gray-500"><%= l(comment.created_at, format: :short) %></small>
                </div>
                <p class="text-gray-700"><%= comment.body %></p>
              </div>
            <% end %>
          <% else %>
            <p class="text-gray-500">No comments yet.</p>
          <% end %>
        </div>
      </div>

      <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <header class="px-6 py-4 bg-gray-50 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900 flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            Post a Comment
          </h2>
        </header>
        <div class="px-6 py-6">
          <%= form_with(model: @dispute, url: post_comment_admin_dispute_path(@dispute), method: :post, class: "space-y-4") do |form| %>
            <div>
              <%= form.label :body, "Comment", class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_area :body, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
            </div>
            <%= form.submit "Post Comment", class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
          <% end %>
        </div>
      </div>
    </section>

    <aside class="lg:col-span-1">
      <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <header class="px-6 py-4 bg-gray-50 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900 flex items-center">
            <svg class="w-5 h-5 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Actions
          </h2>
        </header>
        <div class="px-6 py-6">
          <% if @dispute.pending? || @dispute.under_review? %>
            <div class="mb-6">
              <%= form_with(url: assign_moderator_admin_dispute_path(@dispute), method: :patch) do |form| %>
                <%= form.label :moderator_id, "Assign Moderator", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.collection_select :moderator_id, User.moderator, :id, :username, { include_blank: "Select Moderator" }, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" } %>
                <%= form.submit "Assign Moderator", class: "mt-3 w-full inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-gray-600 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:border-gray-500 transition-colors duration-200" %>
              <% end %>
            </div>

            <hr class="my-6">

            <div>
              <%= form_with(url: resolve_admin_dispute_path(@dispute), method: :patch) do |form| %>
                <%= form.label :resolution, "Resolution", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= form.select :resolution, options_for_select([['Refund Buyer', 'refund_buyer'], ['Release to Seller', 'release_to_seller']]), {}, { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500" } %>
                <%= form.submit "Resolve Dispute", class: "mt-3 w-full inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors duration-200", data: { confirm: "Are you sure you want to resolve this dispute?" } %>
              <% end %>
            </div>
          <% else %>
            <div class="p-4 bg-blue-50 border border-blue-200 rounded-md">
              <div class="flex items-start">
                <svg class="w-5 h-5 text-blue-400 mt-0.5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div>
                  <p class="text-sm text-blue-800">This dispute has been resolved and cannot be modified.</p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
</main>
