<main class="container mx-auto px-4 py-8">
  <nav aria-label="Breadcrumb navigation" class="mb-6">
    <ol class="flex flex-wrap items-center space-x-2 text-sm text-gray-500">
      <li>
        <%= link_to "Admin", admin_root_path, class: "text-blue-600 hover:text-blue-800 transition-colors duration-200" %>
      </li>
      <li class="flex items-center">
        <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
        </svg>
        <%= link_to "Bonds", admin_bonds_path, class: "text-blue-600 hover:text-blue-800 transition-colors duration-200" %>
      </li>
      <li class="flex items-center">
        <svg class="w-4 h-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
        </svg>
        <span class="text-gray-900 font-medium" aria-current="page"><%= @bond.user.username %></span>
      </li>
    </ol>
  </nav>

  <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-4 sm:mb-0">
      <svg class="w-8 h-8 text-blue-600 inline-block mr-3" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
      </svg>
      Bond Details for <%= @bond.user.username %>
    </h1>
    <div class="flex flex-col sm:flex-row gap-3">
      <%= link_to admin_bonds_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Bonds
      <% end %>
      <%= link_to "Edit Bond", edit_admin_bond_path(@bond), class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <section class="lg:col-span-2">
      <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <header class="px-6 py-4 bg-gray-50 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900 flex items-center">
            <svg class="w-5 h-5 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Bond Information
          </h2>
        </header>
        <div class="px-6 py-6">
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Seller</dt>
                <dd class="mt-1">
                  <%= link_to @bond.user.username, admin_user_path(@bond.user), class: "text-blue-600 hover:text-blue-800 transition-colors duration-200" %>
                </dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Amount</dt>
                <dd class="mt-1 text-green-600 font-semibold text-lg"><%= @bond.amount.format %></dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Status</dt>
                <dd class="mt-1">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @bond.status == 'active' ? 'bg-green-100 text-green-800' : (@bond.status == 'pending' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800') %>">
                    <%= @bond.status.humanize %>
                  </span>
                </dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Paid At</dt>
                <dd class="mt-1">
                  <%= @bond.paid_at ? l(@bond.paid_at, format: :long) : '<span class="text-gray-400">Not Paid</span>'.html_safe %>
                </dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Forfeited At</dt>
                <dd class="mt-1">
                  <%= @bond.forfeited_at ? l(@bond.forfeited_at, format: :long) : '<span class="text-gray-400">Not Forfeited</span>'.html_safe %>
                </dd>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              <div>
                <dt class="text-sm font-medium text-gray-500">Returned At</dt>
                <dd class="mt-1">
                  <%= @bond.returned_at ? l(@bond.returned_at, format: :long) : '<span class="text-gray-400">Not Returned</span>'.html_safe %>
                </dd>
              </div>
            </div>
            <% if @bond.forfeiture_reason.present? %>
              <div class="col-span-full">
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-yellow-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                  </svg>
                  <div>
                    <dt class="text-sm font-medium text-gray-500">Forfeiture Reason</dt>
                    <dd class="mt-1 p-4 bg-yellow-50 border border-yellow-200 rounded-md">
                      <%= @bond.forfeiture_reason %>
                    </dd>
                  </div>
                </div>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    </section>

    <aside class="lg:col-span-1">
      <div class="bg-white shadow-lg rounded-lg overflow-hidden">
        <header class="px-6 py-4 bg-gray-50 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900 flex items-center">
            <svg class="w-5 h-5 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Actions
          </h2>
        </header>
        <div class="px-6 py-6">
          <% if @bond.pending? %>
            <div class="mb-4">
              <%= button_to approve_admin_bond_path(@bond), method: :patch, class: "w-full inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors duration-200" do %>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Approve Bond
              <% end %>
            </div>
          <% end %>

          <% if @bond.active? %>
            <div class="mb-4">
              <%= form_with(model: @bond, url: forfeit_admin_bond_path(@bond), method: :patch, class: "space-y-4") do |form| %>
                <div>
                  <%= form.label :forfeiture_reason, "Forfeiture Reason", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.text_area :forfeiture_reason, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500", required: true %>
                </div>
                <%= form.submit "Forfeit Bond", class: "w-full inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors duration-200" %>
              <% end %>
            </div>
          <% end %>

          <% if @bond.forfeited? %>
            <div class="p-4 bg-blue-50 border border-blue-200 rounded-md">
              <div class="flex items-start">
                <svg class="w-5 h-5 text-blue-400 mt-0.5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div>
                  <p class="text-sm text-blue-800">This bond has been forfeited and cannot be modified.</p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
</main>
