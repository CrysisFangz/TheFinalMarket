  <meta name="apple-mobile-web-app-title" content="TheFinalMarket">
<% end %>

<% content_for :javascript do %>
  <script>
    // Enhanced Order History Page Performance Optimizations
    document.addEventListener('DOMContentLoaded', function() {
      // Filter functionality
      const filterTabs = document.querySelectorAll('.filter-tab');
      const orderCards = document.querySelectorAll('.order-card-modern');

      filterTabs.forEach(tab => {
        tab.addEventListener('click', function() {
          const filter = this.dataset.filter;

          // Update active tab
          filterTabs.forEach(t => {
            t.classList.remove('active', 'bg-purple-600', 'text-white');
            t.classList.add('bg-gray-100', 'text-gray-700');
            t.setAttribute('aria-selected', 'false');
          });

          this.classList.add('active', 'bg-purple-600', 'text-white');
          this.classList.remove('bg-gray-100', 'text-gray-700');
          this.setAttribute('aria-selected', 'true');

          // Filter orders
          orderCards.forEach(card => {
            const orderStatus = card.dataset.orderStatus;
            if (filter === 'all' || orderStatus === filter) {
              card.style.display = 'block';
              card.classList.add('animate-fade-in');
            } else {
              card.style.display = 'none';
              card.classList.remove('animate-fade-in');
            }
          });

          // Announce filter change to screen readers
          const count = Array.from(orderCards).filter(card => {
            const orderStatus = card.dataset.orderStatus;
            return filter === 'all' || orderStatus === filter;
          }).length;

          announceToScreenReader(`Filtered to ${count} orders`);
        });
      });

      // Search functionality
      const searchInput = document.getElementById('order-search');
      if (searchInput) {
        let searchTimeout;

        searchInput.addEventListener('input', function() {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            const query = this.value.toLowerCase().trim();

            orderCards.forEach(card => {
              const orderId = card.querySelector('.order-id').textContent.toLowerCase();
              const orderItems = card.querySelectorAll('.order-item-name');
              let hasMatch = false;

              // Check order ID
              if (orderId.includes(query)) {
                hasMatch = true;
              }

              // Check product names
              orderItems.forEach(item => {
                if (item.textContent.toLowerCase().includes(query)) {
                  hasMatch = true;
                }
              });

              if (query === '' || hasMatch) {
                card.style.display = 'block';
                card.classList.add('animate-fade-in');
              } else {
                card.style.display = 'none';
                card.classList.remove('animate-fade-in');
              }
            });

            // Update visible count
            const visibleCount = Array.from(orderCards).filter(card => card.style.display !== 'none').length;
            announceToScreenReader(`Search results: ${visibleCount} orders found`);
          }, 300); // Debounce search
        });
      }

      // Enhanced keyboard navigation for filter tabs
      filterTabs.forEach((tab, index) => {
        tab.addEventListener('keydown', function(e) {
          if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
            e.preventDefault();
            const direction = e.key === 'ArrowLeft' ? -1 : 1;
            const nextIndex = (index + direction + filterTabs.length) % filterTabs.length;
            filterTabs[nextIndex].focus();
            filterTabs[nextIndex].click();
          }
        });
      });

      // Smooth scroll for order cards
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-fade-in');
          }
        });
      }, { threshold: 0.1 });

      orderCards.forEach(card => observer.observe(card));

      // Performance monitoring
      if ('PerformanceObserver' in window) {
        const observer = new PerformanceObserver((list) => {
          for (const entry of list.getEntries()) {
            if (entry.entryType === 'largest-contentful-paint') {
              console.log('LCP:', entry.startTime);
            }
            if (entry.entryType === 'first-input') {
              console.log('FID:', entry.processingStart - entry.startTime);
            }
          }
        });
        observer.observe({ entryTypes: ['largest-contentful-paint', 'first-input'] });
      }

      // Screen reader announcements
      function announceToScreenReader(message) {
        const announcement = document.createElement('div');
        announcement.setAttribute('aria-live', 'polite');
        announcement.setAttribute('aria-atomic', 'true');
        announcement.className = 'sr-only';
        announcement.textContent = message;
        document.body.appendChild(announcement);

        setTimeout(() => {
          document.body.removeChild(announcement);
        }, 1000);
      }
    });

    // Order status schema for SEO
    const ordersSchema = {
      "@context": "https://schema.org/",
      "@type": "CollectionPage",
      "name": "My Orders",
      "description": "Order history and tracking for TheFinalMarket customers",
      "url": "<%= request.original_url %>",
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": <%= @orders.count %>,
        "itemListElement": [
          <% @orders.each_with_index do |order, index| %>
            {
              "@type": "Order",
              "position": <%= index + 1 %>,
              "orderNumber": "<%= order.id %>",
              "orderDate": "<%= order.created_at.iso8601 %>",
              "orderStatus": "<%= order.status %>",
              "price": "<%= order.total_amount %>",
              "priceCurrency": "USD"
            }<%= ',' unless index == @orders.count - 1 %>
          <% end %>
        ]
      }
    };

    // Add schema to page
    const script = document.createElement('script');
    script.type = 'application/ld+json';
    script.textContent = JSON.stringify(ordersSchema);
    document.head.appendChild(script);
  </script>
<% end %></search>
</search_and_replace>