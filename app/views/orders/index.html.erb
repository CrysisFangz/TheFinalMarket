<%# Modern Enhanced Order History Page - WCAG AAA Compliant %>
<main class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-purple-50" role="main" aria-labelledby="orders-title">

  <%# Page Header with Enhanced Accessibility %>
  <header class="bg-white border-b border-gray-200" role="banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <h1 id="orders-title" class="text-4xl font-extrabold text-gray-900 mb-2 leading-tight tracking-tight">
            My Orders
          </h1>
          <p class="text-lg text-gray-600">
            Track and manage all your purchases in one place
          </p>
        </div>
        <div class="flex-shrink-0">
          <%= link_to root_path,
              class: "inline-flex items-center gap-3 px-6 py-3 bg-gray-100 text-gray-700 rounded-lg font-semibold hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-all duration-300 transform hover:scale-105",
              aria-label: "Continue shopping for more products" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <span>Continue Shopping</span>
          <% end %>
        </div>
      </div>
    </div>
  </header></search>
</search_and_replace>

    <% if @orders.any? %>
    <%# Order Statistics with Enhanced Accessibility %>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-labelledby="order-stats-heading">
      <h2 id="order-stats-heading" class="sr-only">Order Statistics</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        <article class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 p-6" role="group" aria-labelledby="total-orders-heading">
          <div class="flex items-center gap-4">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center">
                <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
                </svg>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <p id="total-orders-heading" class="text-sm font-semibold text-gray-600 mb-1">Total Orders</p>
              <p class="text-2xl font-extrabold text-gray-900" aria-label="<%= @orders.count %> total orders"><%= @orders.count %></p>
            </div>
          </div>
        </article>

        <article class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 p-6" role="group" aria-labelledby="delivered-orders-heading">
          <div class="flex items-center gap-4">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-green-600 rounded-xl flex items-center justify-center">
                <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <p id="delivered-orders-heading" class="text-sm font-semibold text-gray-600 mb-1">Delivered</p>
              <p class="text-2xl font-extrabold text-gray-900" aria-label="<%= @orders.where(status: :delivered).count %> delivered orders"><%= @orders.where(status: :delivered).count %></p>
            </div>
          </div>
        </article>

        <article class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 p-6" role="group" aria-labelledby="in-transit-heading">
          <div class="flex items-center gap-4">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl flex items-center justify-center">
                <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/>
                  <path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/>
                </svg>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <p id="in-transit-heading" class="text-sm font-semibold text-gray-600 mb-1">In Transit</p>
              <p class="text-2xl font-extrabold text-gray-900" aria-label="<%= @orders.where(status: [:pending, :processing, :shipped]).count %> orders in transit"><%= @orders.where(status: [:pending, :processing, :shipped]).count %></p>
            </div>
          </div>
        </article>

        <article class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 p-6" role="group" aria-labelledby="total-spent-heading">
          <div class="flex items-center gap-4">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center">
                <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"/>
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"/>
                </svg>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <p id="total-spent-heading" class="text-sm font-semibold text-gray-600 mb-1">Total Spent</p>
              <p class="text-2xl font-extrabold text-gray-900" aria-label="Total spent $<%= number_with_precision(@orders.sum(:total_amount), precision: 2) %>">$<%= number_with_precision(@orders.sum(:total_amount), precision: 2) %></p>
            </div>
          </div>
        </article>
      </div>
    </section></search>
</search_and_replace>

        <%# Filter and Search Bar with Enhanced Accessibility %>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8" aria-labelledby="filters-heading">
      <h2 id="filters-heading" class="sr-only">Filter and Search Orders</h2>
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <div class="flex flex-col lg:flex-row gap-6">
          <%# Filter Tabs %>
          <div class="flex-1">
            <fieldset>
              <legend class="sr-only">Filter orders by status</legend>
              <div class="flex flex-wrap gap-2" role="group" aria-label="Order status filters">
                <button class="filter-tab active inline-flex items-center gap-2 px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2"
                        data-filter="all"
                        role="tab"
                        aria-selected="true"
                        aria-controls="orders-list"
                        aria-label="Show all orders (<%= @orders.count %>)">
                  <span>All Orders</span>
                  <span class="filter-badge bg-purple-100 text-purple-700 px-2 py-1 rounded-full text-xs font-bold" aria-hidden="true"><%= @orders.count %></span>
                </button>
                <button class="filter-tab inline-flex items-center gap-2 px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2"
                        data-filter="pending"
                        role="tab"
                        aria-selected="false"
                        aria-controls="orders-list"
                        aria-label="Show processing orders (<%= @orders.where(status: [:pending, :processing]).count %>)">
                  <span>Processing</span>
                  <span class="filter-badge bg-blue-100 text-blue-700 px-2 py-1 rounded-full text-xs font-bold" aria-hidden="true"><%= @orders.where(status: [:pending, :processing]).count %></span>
                </button>
                <button class="filter-tab inline-flex items-center gap-2 px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2"
                        data-filter="shipped"
                        role="tab"
                        aria-selected="false"
                        aria-controls="orders-list"
                        aria-label="Show shipped orders (<%= @orders.where(status: :shipped).count %>)">
                  <span>Shipped</span>
                  <span class="filter-badge bg-orange-100 text-orange-700 px-2 py-1 rounded-full text-xs font-bold" aria-hidden="true"><%= @orders.where(status: :shipped).count %></span>
                </button>
                <button class="filter-tab inline-flex items-center gap-2 px-4 py-2 rounded-lg font-semibold text-sm transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2"
                        data-filter="delivered"
                        role="tab"
                        aria-selected="false"
                        aria-controls="orders-list"
                        aria-label="Show delivered orders (<%= @orders.where(status: :delivered).count %>)">
                  <span>Delivered</span>
                  <span class="filter-badge bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-bold" aria-hidden="true"><%= @orders.where(status: :delivered).count %></span>
                </button>
              </div>
            </fieldset>
          </div>

          <%# Search Input %>
          <div class="lg:w-80">
            <label for="order-search" class="sr-only">Search orders</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              <input type="search"
                     id="order-search"
                     class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-colors text-base"
                     placeholder="Search orders by ID or product name..."
                     aria-describedby="search-help">
            </div>
            <p id="search-help" class="text-xs text-gray-500 mt-1">Search by order number, product name, or seller</p>
          </div>
        </div>
      </div>
    </section></search>
</search_and_replace>

        <%# Orders List with Enhanced Accessibility %>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-labelledby="orders-list-heading">
      <h2 id="orders-list-heading" class="sr-only">Your Orders</h2>
      <div class="space-y-6" role="list" aria-label="Orders list">
        <% @orders.each_with_index do |order, index| %>
          <article class="order-card-modern bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 overflow-hidden"
                   data-scroll-animation-target="animated"
                   data-order-status="<%= order.status %>"
                   style="animation-delay: <%= index * 0.1 %>s"
                   role="listitem"
                   aria-labelledby="order-<%= order.id %>-title">

            <%# Order Header with Enhanced Accessibility %>
            <header class="order-card-header p-6 bg-gray-50 border-b border-gray-200">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex flex-col gap-2">
                  <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
                      <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
                    </svg>
                    <h3 id="order-<%= order.id %>-title" class="text-lg font-bold text-gray-900">
                      Order #<%= order.id %>
                    </h3>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-gray-600">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                    </svg>
                    <time datetime="<%= order.created_at.iso8601 %>" aria-label="Order date <%= order.created_at.strftime("%B %d, %Y") %>">
                      <%= order.created_at.strftime("%b %d, %Y") %>
                    </time>
                  </div>
                </div>

                <div class="flex items-center gap-4">
                  <span class="status-badge status-<%= order.status %> inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold capitalize"
                        role="status"
                        aria-label="Order status: <%= order.status.titleize %>">
                    <%= order.status.titleize %>
                  </span>
                  <div class="text-right">
                    <p class="text-2xl font-bold text-gray-900" aria-label="Order total $<%= number_with_precision(order.total_amount, precision: 2) %>">
                      $<%= number_with_precision(order.total_amount, precision: 2) %>
                    </p>
                    <p class="text-xs text-gray-500">Total</p>
                  </div>
                </div>
              </div>
            </header></search>
</search_and_replace>

                      <%# Order Progress Bar with Enhanced Accessibility %>
            <% if order.status.in?(["processing", "shipped"]) %>
              <section class="order-progress p-6 bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200" aria-labelledby="order-<%= order.id %>-progress">
                <h3 id="order-<%= order.id %>-progress" class="sr-only">Order Progress for Order #<%= order.id %></h3>
                <div class="flex items-center justify-between" role="group" aria-label="Order tracking progress">
                  <div class="flex items-center gap-2 <%= 'opacity-100' if order.status.in?(["processing", "shipped", "delivered"]) %>">
                    <div class="progress-dot-h w-4 h-4 rounded-full <%= 'bg-green-500' if order.status.in?(["processing", "shipped", "delivered"]) %> <%= 'bg-gray-300' unless order.status.in?(["processing", "shipped", "delivered"]) %> transition-colors duration-300"></div>
                    <span class="progress-label-h text-sm font-medium <%= 'text-green-700' if order.status.in?(["processing", "shipped", "delivered"]) %> <%= 'text-gray-500' unless order.status.in?(["processing", "shipped", "delivered"]) %>">Order Placed</span>
                  </div>

                  <div class="progress-line-h flex-1 h-0.5 bg-gray-300 mx-4 <%= 'bg-purple-500' if order.status.in?(["shipped", "delivered"]) %> transition-colors duration-300"></div>

                  <div class="flex items-center gap-2 <%= 'opacity-100' if order.status.in?(["shipped", "delivered"]) %> <%= 'opacity-60' if order.status == 'processing' %>">
                    <div class="progress-dot-h w-4 h-4 rounded-full <%= 'bg-green-500' if order.status.in?(["shipped", "delivered"]) %> <%= 'bg-purple-500 animate-pulse' if order.status == 'processing' %> <%= 'bg-gray-300' unless order.status.in?(["processing", "shipped", "delivered"]) %> transition-colors duration-300"></div>
                    <span class="progress-label-h text-sm font-medium <%= 'text-green-700' if order.status.in?(["shipped", "delivered"]) %> <%= 'text-purple-700' if order.status == 'processing' %> <%= 'text-gray-500' unless order.status.in?(["processing", "shipped", "delivered"]) %>">Processing</span>
                  </div>

                  <div class="progress-line-h flex-1 h-0.5 bg-gray-300 mx-4 <%= 'bg-purple-500' if order.status == 'delivered' %> transition-colors duration-300"></div>

                  <div class="flex items-center gap-2 <%= 'opacity-100' if order.status == 'delivered' %> <%= 'opacity-60' if order.status == 'shipped' %>">
                    <div class="progress-dot-h w-4 h-4 rounded-full <%= 'bg-green-500' if order.status == 'delivered' %> <%= 'bg-purple-500 animate-pulse' if order.status == 'shipped' %> <%= 'bg-gray-300' unless order.status.in?(["shipped", "delivered"]) %> transition-colors duration-300"></div>
                    <span class="progress-label-h text-sm font-medium <%= 'text-green-700' if order.status == 'delivered' %> <%= 'text-purple-700' if order.status == 'shipped' %> <%= 'text-gray-500' unless order.status.in?(["shipped", "delivered"]) %>">Shipped</span>
                  </div>

                  <div class="progress-line-h flex-1 h-0.5 bg-gray-300 mx-4"></div>

                  <div class="flex items-center gap-2 opacity-60">
                    <div class="progress-dot-h w-4 h-4 rounded-full bg-gray-300"></div>
                    <span class="progress-label-h text-sm font-medium text-gray-500">Delivered</span>
                  </div>
                </div>

                <%# Estimated Delivery Date %>
                <% if order.status.in?(["processing", "shipped"]) %>
                  <div class="mt-4 text-center">
                    <p class="text-sm text-gray-600">
                      <% if order.status == 'processing' %>
                        <span class="inline-flex items-center gap-2">
                          <svg class="w-4 h-4 text-blue-500 animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                          </svg>
                          Processing your order...
                        </span>
                      <% else %>
                        <span class="inline-flex items-center gap-2">
                          <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l2.414 2.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
                          </svg>
                          Estimated delivery: <%= 3.days.from_now.strftime("%b %d, %Y") %>
                        </span>
                      <% end %>
                    </p>
                  </div>
                <% end %>
              </section>
            <% end %></search>
</search_and_replace>

                      <%# Order Items with Enhanced Accessibility %>
            <section class="order-items-preview p-6" aria-labelledby="order-<%= order.id %>-items">
              <h3 id="order-<%= order.id %>-items" class="sr-only">Items in Order #<%= order.id %></h3>
              <div class="space-y-4">
                <% order.order_items.limit(3).each do |order_item| %>
                  <div class="order-item-preview flex items-center gap-4 p-3 bg-gray-50 rounded-lg border border-gray-200">
                    <div class="flex-shrink-0">
                      <% if order_item.item.images.attached? %>
                        <%= image_tag order_item.item.images.first.variant(resize_to_limit: [80, 80]),
                            class: "order-item-image w-16 h-16 object-cover rounded-lg border-2 border-gray-200",
                            alt: "Product image of #{order_item.item.name}",
                            loading: "lazy" %>
                      <% else %>
                        <div class="order-item-image-placeholder w-16 h-16 bg-gray-200 rounded-lg border-2 border-gray-300 flex items-center justify-center">
                          <svg class="w-8 h-8 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                          </svg>
                        </div>
                      <% end %>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="order-item-name text-sm font-semibold text-gray-900 truncate" title="<%= order_item.item.name %>">
                        <%= order_item.item.name %>
                      </h4>
                      <div class="order-item-meta text-sm text-gray-600 mt-1">
                        <span aria-label="Quantity: <%= order_item.quantity %>">Qty: <%= order_item.quantity %></span>
                        <span class="text-gray-400 mx-1">×</span>
                        <span aria-label="Unit price $<%= number_with_precision(order_item.unit_price, precision: 2) %>">$<%= number_with_precision(order_item.unit_price, precision: 2) %></span>
                      </div>
                    </div>
                    <div class="order-item-subtotal text-right">
