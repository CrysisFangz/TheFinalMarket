  <meta name="description" content="<%= @page_description || 'View and manage your order history. Track your purchases, view order details, and monitor delivery status.' %>">
  <meta name="keywords" content="orders, order history, purchase tracking, delivery status, order management">
  <meta name="robots" content="index, follow">
  <meta property="og:title" content="<%= @page_title || 'My Orders - TheFinalMarket' %>">
  <meta property="og:description" content="<%= @page_description || 'Track and manage all your purchases in one place' %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:image" content="<%= asset_url('icon.png') %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @page_title || 'My Orders - TheFinalMarket' %>">
  <meta name="twitter:description" content="<%= @page_description || 'Track and manage all your purchases in one place' %>">
  <meta name="twitter:image" content="<%= asset_url('icon.png') %>">
  <link rel="canonical" href="<%= request.original_url %>">
  <link rel="preload" href="<%= asset_path('application.js') %>" as="script">
