<%# Modern Enhanced Product Edit Page - WCAG AAA Compliant %>
<main class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-purple-50" role="main" aria-labelledby="edit-product-title">

  <%# Breadcrumb Navigation with Enhanced Accessibility %>
  <nav class="bg-white border-b border-gray-200" aria-label="Breadcrumb navigation">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <ol class="flex items-center gap-2 text-sm" role="list">
        <li>
          <%= link_to "Home", root_path,
              class: "text-gray-500 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 rounded px-1 py-0.5 transition-colors",
              aria-label: "Go to home page" %>
        </li>
        <li class="flex items-center gap-2" aria-hidden="true">
          <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </li>
        <li>
          <%= link_to "Products", products_path,
              class: "text-gray-500 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 rounded px-1 py-0.5 transition-colors",
              aria-label: "Browse all products" %>
        </li>
        <li class="flex items-center gap-2" aria-hidden="true">
          <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </li>
        <li>
          <%= link_to @product.name, @product,
              class: "text-gray-500 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 rounded px-1 py-0.5 transition-colors max-w-xs truncate",
              title: @product.name,
              aria-label: "View product details for #{product.name}" %>
        </li>
        <li class="flex items-center gap-2" aria-hidden="true">
          <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </li>
        <li>
          <span class="text-gray-900 font-medium px-1 py-0.5" aria-current="page">Edit Product</span>
        </li>
      </ol>
    </div>
  </nav>

  <%# Main Content Section %>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="text-center mb-8">
      <h1 id="edit-product-title" class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight tracking-tight">
        Edit Product
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Update your product information. Changes will be reflected immediately on your product page.
      </p>
      <div class="mt-4 flex items-center justify-center gap-2 text-sm text-gray-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Editing: <strong><%= @product.name %></strong></span>
      </div>
    </header>

    <%# Product Form Card %>
    <article class="bg-white shadow-xl rounded-2xl overflow-hidden" role="form" aria-labelledby="edit-product-title">
      <div class="p-8">
        <%= render 'form', product: @product %>
      </div>
    </article>

    <%# Product Status Information %>
    <aside class="mt-8 bg-green-50 border border-green-200 rounded-xl p-6" role="complementary" aria-labelledby="product-status-heading">
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0">
          <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="flex-1">
          <h2 id="product-status-heading" class="text-sm font-semibold text-green-800 mb-2">Product Status</h2>
          <div class="text-sm text-green-700 space-y-1">
            <p class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-400 rounded-full"></span>
              <span>Product is currently <%= @product.stock_quantity.to_i > 0 ? 'in stock' : 'out of stock' %></span>
            </p>
            <p class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-400 rounded-full"></span>
              <span>Listed in <%= pluralize(@product.categories.count, 'category') %></span>
            </p>
            <% if @product.reviews.any? %>
              <p class="flex items-center gap-2">
                <span class="w-2 h-2 bg-green-400 rounded-full"></span>
                <span>Has <%= pluralize(@product.reviews.count, 'review') %> from customers</span>
              </p>
            <% end %>
          </div>
        </div>
      </div>
    </aside>

    <%# Quick Actions %>
    <aside class="mt-6 bg-blue-50 border border-blue-200 rounded-xl p-6" role="complementary" aria-labelledby="quick-actions-heading">
      <h2 id="quick-actions-heading" class="text-lg font-semibold text-blue-900 mb-3">Quick Actions</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <%= link_to @product,
            class: "flex items-center gap-3 p-3 bg-white rounded-lg border border-blue-200 hover:border-blue-300 hover:bg-blue-50 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2",
            aria-label: "View product details for #{product.name}" do %>
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span class="text-sm font-medium text-blue-900">View Product</span>
        <% end %>

        <%= link_to product_analytics_path(@product),
            class: "flex items-center gap-3 p-3 bg-white rounded-lg border border-blue-200 hover:border-blue-300 hover:bg-blue-50 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2",
            aria-label: "View analytics for #{product.name}" do %>
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <span class="text-sm font-medium text-blue-900">View Analytics</span>
        <% end %>
      </div>
    </aside>
  </section>
</main>

<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Edit your product listing on TheFinalMarket. Update product details, images, pricing, and categories.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="canonical" href="<%= request.original_url %>">
  <link rel="preload" href="<%= asset_path('application.js') %>" as="script">
  <link rel="preload" href="<%= asset_path('application.css') %>" as="style">
  <meta name="theme-color" content="#7C3AED">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="TheFinalMarket">
<% end %>

<% content_for :javascript do %>
  <script>
    // Enhanced Product Edit Page Performance Optimizations
    document.addEventListener('DOMContentLoaded', function() {
      // Auto-save functionality (if needed)
      const form = document.querySelector('form');
      if (form) {
        let autoSaveTimer;

        // Track changes for potential auto-save
        form.addEventListener('input', function() {
          clearTimeout(autoSaveTimer);
          autoSaveTimer = setTimeout(function() {
            // Could implement auto-save here
            console.log('Form changes detected - could auto-save');
          }, 2000); // Auto-save after 2 seconds of inactivity
        });

        // Warn before leaving with unsaved changes
        let hasUnsavedChanges = false;

        form.addEventListener('input', function() {
          hasUnsavedChanges = true;
        });

        window.addEventListener('beforeunload', function(e) {
          if (hasUnsavedChanges) {
            e.preventDefault();
            e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
          }
        });

        // Reset unsaved changes flag on successful submit
        form.addEventListener('submit', function() {
          hasUnsavedChanges = false;
        });
      }

      // Enhanced form validation with real-time feedback
      const requiredFields = document.querySelectorAll('input[required], textarea[required], select[required]');

      requiredFields.forEach(field => {
        field.addEventListener('blur', function() {
          validateField(this);
        });

        field.addEventListener('input', function() {
          if (this.classList.contains('border-red-500')) {
            validateField(this);
          }
        });
      });

      function validateField(field) {
        const isValid = field.checkValidity();
        const hasValue = field.value.trim().length > 0;

        if (field.hasAttribute('required') && !hasValue) {
          field.classList.add('border-red-500', 'focus:ring-red-500', 'focus:border-red-500');
          field.setAttribute('aria-invalid', 'true');
        } else if (isValid && hasValue) {
          field.classList.remove('border-red-500', 'focus:ring-red-500', 'focus:border-red-500');
          field.setAttribute('aria-invalid', 'false');
        }
      }

      // Performance monitoring
      if ('PerformanceObserver' in window) {
        const observer = new PerformanceObserver((list) => {
          for (const entry of list.getEntries()) {
            if (entry.entryType === 'largest-contentful-paint') {
              console.log('LCP:', entry.startTime);
            }
            if (entry.entryType === 'first-input') {
              console.log('FID:', entry.processingStart - entry.startTime);
            }
          }
        });
        observer.observe({ entryTypes: ['largest-contentful-paint', 'first-input'] });
      }
    });
  </script>
<% end %></search>
</search_and_replace>
