<%# Enhanced Product Form - WCAG AAA Compliant %>
<%= form_with(model: product, local: true, class: "space-y-8", data: { controller: "form-validation" }) do |f| %>

  <%# Error Summary with Enhanced Accessibility %>
  <% if product.errors.any? %>
    <section class="bg-red-50 border border-red-200 rounded-xl p-6" role="alert" aria-labelledby="error-summary-heading">
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0">
          <svg class="w-5 h-5 text-red-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="flex-1">
          <h3 id="error-summary-heading" class="text-sm font-semibold text-red-800 mb-2">
            <%= pluralize(product.errors.count, "error") %> prevented this product from being saved
          </h3>
          <ul class="text-sm text-red-700 space-y-1" role="list">
            <% product.errors.full_messages.each do |message| %>
              <li class="flex items-start gap-2">
                <span class="text-red-400 mt-1" aria-hidden="true">•</span>
                <span><%= message %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </section>
  <% end %>

  <%# Product Name Field %>
  <fieldset class="space-y-3">
    <legend class="sr-only">Product Basic Information</legend>

    <div class="space-y-2">
      <label for="product_name" class="block text-sm font-semibold text-gray-700">
        Product Name <span class="text-red-500" aria-label="required">*</span>
      </label>
      <%= f.text_field :name,
          id: "product_name",
          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-colors text-base",
          placeholder: "Enter a descriptive product name",
          required: true,
          maxlength: 100,
          aria: { describedby: "name-help" } %>
      <p id="name-help" class="text-sm text-gray-500">
        Choose a clear, descriptive name that helps customers find your product (max 100 characters)
      </p>
    </div>

    <%# Product Description Field %>
    <div class="space-y-2">
      <label for="product_description" class="block text-sm font-semibold text-gray-700">
        Description <span class="text-red-500" aria-label="required">*</span>
      </label>
      <%= f.text_area :description,
          id: "product_description",
          rows: 6,
          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-colors text-base resize-vertical",
          placeholder: "Describe your product in detail. Include features, benefits, specifications, and any other relevant information that will help customers make an informed decision.",
          required: true,
          maxlength: 2000,
          aria: { describedby: "description-help" } %>
      <div class="flex justify-between items-center">
        <p id="description-help" class="text-sm text-gray-500">
          Provide a detailed description including features, benefits, and specifications (max 2000 characters)
        </p>
        <span class="text-xs text-gray-400" id="description-count">0/2000</span>
      </div>
    </div>
  </fieldset>

  <%# Pricing Section %>
  <fieldset class="space-y-3">
    <legend class="text-lg font-semibold text-gray-900 mb-4">Pricing Information</legend>

    <div class="space-y-2">
      <label for="product_price" class="block text-sm font-semibold text-gray-700">
        Price (USD) <span class="text-red-500" aria-label="required">*</span>
      </label>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <span class="text-gray-500 text-lg">$</span>
        </div>
        <%= f.number_field :price,
            id: "product_price",
            class: "w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-colors text-base",
            placeholder: "0.00",
            step: 0.01,
            min: 0,
            required: true,
            aria: { describedby: "price-help" } %>
      </div>
      <p id="price-help" class="text-sm text-gray-500">
        Set a competitive price. Consider market rates and your profit margins.
      </p>
    </div>
  </fieldset>

  <%# Media Section %>
  <fieldset class="space-y-3">
    <legend class="text-lg font-semibold text-gray-900 mb-4">Product Images</legend>

    <div class="space-y-2">
      <label for="product_images" class="block text-sm font-semibold text-gray-700">
        Product Images
      </label>
      <%= f.file_field :images,
          id: "product_images",
          multiple: true,
          accept: "image/*",
          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-colors text-base file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100",
          aria: { describedby: "images-help" } %>
      <p id="images-help" class="text-sm text-gray-500">
        Upload high-quality images (JPEG, PNG, GIF, WebP). Maximum 5MB per image. Multiple images allowed.
      </p>

      <%# Image Preview Area %>
      <div id="image-preview" class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-4 hidden" aria-live="polite">
        <%# Image previews will be inserted here by JavaScript %>
      </div>
    </div>
  </fieldset>

  <%# Categories Section %>
  <fieldset class="space-y-3">
    <legend class="text-lg font-semibold text-gray-900 mb-4">Categories</legend>

    <div class="space-y-3">
      <p class="text-sm text-gray-600">Select all categories that apply to your product:</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-64 overflow-y-auto border border-gray-200 rounded-lg p-4">
        <%= f.collection_check_boxes(:category_ids, Category.all.order(:name), :id, :name) do |b| %>
          <div class="flex items-center space-x-3 p-2 hover:bg-gray-50 rounded-lg transition-colors">
            <%= b.check_box(
                class: "w-4 h-4 text-purple-600 bg-gray-100 border-gray-300 rounded focus:ring-purple-500 focus:ring-2",
                aria: { describedby: "category-#{b.object.id}-help" }
            ) %>
            <%= b.label(
                class: "text-sm font-medium text-gray-700 cursor-pointer flex-1"
            ) do %>
              <%= b.object.name %>
              <% if b.object.description.present? %>
                <span class="block text-xs text-gray-500 mt-1"><%= b.object.description %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
      <p class="text-sm text-gray-500">
        Choose relevant categories to help customers discover your product more easily.
      </p>
    </div>
  </fieldset>

  <%# Form Actions %>
  <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-gray-200">
    <%= f.submit "Create Product",
        class: "flex-1 bg-purple-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 transition-all duration-300 transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none",
        data: { disable_with: "Creating..." } %>

    <%= link_to "Cancel",
        products_path,
        class: "flex-1 bg-gray-100 text-gray-700 px-6 py-3 rounded-lg font-semibold hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-all duration-300 text-center",
        role: "button" %>
  </div>
<% end %>

<% content_for :javascript do %>
  <script>
    // Enhanced Form Validation and Character Counting
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.querySelector('form');
      const descriptionField = document.getElementById('product_description');
      const descriptionCount = document.getElementById('description-count');
      const imageInput = document.getElementById('product_images');
      const imagePreview = document.getElementById('image-preview');

      // Character counter for description
      if (descriptionField && descriptionCount) {
        function updateCharCount() {
          const count = descriptionField.value.length;
          const max = 2000;
          descriptionCount.textContent = `${count}/${max}`;
          descriptionCount.className = count > max * 0.9 ? 'text-xs text-red-500' : 'text-xs text-gray-400';
        }

        descriptionField.addEventListener('input', updateCharCount);
        updateCharCount(); // Initial count
      }

      // Image preview functionality
      if (imageInput && imagePreview) {
        imageInput.addEventListener('change', function(e) {
          imagePreview.innerHTML = '';
          imagePreview.classList.add('hidden');

          Array.from(e.target.files).forEach((file, index) => {
            if (index >= 6) return; // Limit to 6 images

            const reader = new FileReader();
            reader.onload = function(e) {
              const div = document.createElement('div');
              div.className = 'relative group';
              div.innerHTML = `
                <img src="${e.target.result}" alt="Preview ${index + 1}" class="w-full h-24 object-cover rounded-lg border-2 border-gray-200">
                <button type="button" class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" aria-label="Remove image">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              `;
              imagePreview.appendChild(div);
              imagePreview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
          });
        });
      }

      // Real-time validation
      form.querySelectorAll('input, textarea').forEach(field => {
        field.addEventListener('blur', function() {
          validateField(this);
        });

        field.addEventListener('input', function() {
          if (this.classList.contains('border-red-500')) {
            validateField(this);
          }
        });
      });

      function validateField(field) {
        const isValid = field.checkValidity();
        const hasValue = field.value.trim().length > 0;

        if (field.hasAttribute('required') && !hasValue) {
          field.classList.add('border-red-500', 'focus:ring-red-500', 'focus:border-red-500');
          field.setAttribute('aria-invalid', 'true');
        } else if (isValid && hasValue) {
          field.classList.remove('border-red-500', 'focus:ring-red-500', 'focus:border-red-500');
          field.setAttribute('aria-invalid', 'false');
        }
      }
    });
  </script>
<% end %></search>
</search_and_replace>