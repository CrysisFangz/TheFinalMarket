<main class="container mx-auto px-4 py-8">
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-4 flex items-center">
      <svg class="w-8 h-8 text-blue-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
      Shopping Cart
    </h1>
  </header>

  <% if @cart_items.any? %>
    <div class="bg-white shadow-lg rounded-lg overflow-hidden mb-6">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200" role="table" aria-label="Shopping Cart Items">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quantity</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subtotal</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @cart_items.each do |cart_item| %>
              <tr class="hover:bg-gray-50 transition-colors duration-200">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <% if cart_item.item.images.attached? %>
                      <%= image_tag cart_item.item.images.first, class: "h-12 w-12 rounded-lg object-cover", alt: cart_item.item.name %>
                    <% else %>
                      <div class="h-12 w-12 rounded-lg bg-gray-200 flex items-center justify-center">
                        <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                      </div>
                    <% end %>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900">
                        <%= link_to cart_item.item.name, item_path(cart_item.item), class: "text-blue-600 hover:text-blue-800 transition-colors duration-200" %>
                      </div>
                      <div class="text-sm text-gray-500">
                        Seller: <%= link_to cart_item.item.user.name, user_path(cart_item.item.user), class: "text-gray-600 hover:text-gray-800 transition-colors duration-200" %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900">$<%= number_with_precision(cart_item.item.price, precision: 2) %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= form_with(model: cart_item, local: true, class: "flex items-center") do |f| %>
                    <%= f.number_field :quantity, min: 1, value: cart_item.quantity, class: "w-20 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
                    <%= f.submit "Update", class: "ml-3 inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900">$<%= number_with_precision(cart_item.subtotal, precision: 2) %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= button_to "Remove", cart_item_path(cart_item), method: :delete,
                      class: "inline-flex items-center px-3 py-1 border border-transparent text-sm font-medium rounded-md text-red-600 hover:text-red-800 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors duration-200",
                      data: { confirm: "Are you sure you want to remove this item?" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white shadow-lg rounded-lg p-6">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
        <div class="mb-4 lg:mb-0">
          <div class="text-2xl font-bold text-gray-900">
            Total: <span class="text-green-600">$<%= number_with_precision(@total, precision: 2) %></span>
          </div>
          <p class="text-sm text-gray-500 mt-1">Including all taxes and fees</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <%= button_to "Clear Cart", clear_cart_items_path,
              method: :delete,
              class: "inline-flex items-center justify-center px-6 py-2 border border-red-300 rounded-md text-sm font-medium text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-colors duration-200",
              data: { confirm: "Are you sure you want to clear your cart?" } %>
          <%= link_to "Proceed to Checkout", new_order_path,
              class: "inline-flex items-center justify-center px-6 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="bg-white shadow-lg rounded-lg overflow-hidden">
      <div class="text-center py-16">
        <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        <h3 class="mt-4 text-lg font-medium text-gray-900">Your cart is empty</h3>
        <p class="mt-2 text-sm text-gray-500">Add some items to get started with your purchase.</p>
        <div class="mt-6">
          <%= link_to "Continue Shopping", root_path,
              class: "inline-flex items-center px-6 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
        </div>
      </div>
    </div>
  <% end %>
</main>